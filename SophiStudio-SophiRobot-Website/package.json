{
  "name": "profabx-humanoid-configurator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build --configLoader native",
    "test": "node --test tests/workflow-return.node.cjs && vitest run --configLoader native",
    "convert": "node scripts/convert.cjs",
    "preview": "vite preview --configLoader native --host 127.0.0.1 --port 5173 --strictPort",
    "start": "node scripts/serve.cjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "occt-import-js": "0.0.23"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
