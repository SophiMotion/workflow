+.experiment-actions button:hover:not(:disabled),
+.field-options button:hover,
+.telemetry-quality button:hover,
+.chart-legend button:hover,
+.stable-window-marker:hover,
+.experiment-actions button:focus-visible,
+.field-options button:focus-visible,
+.telemetry-quality button:focus-visible,
+.chart-legend button:focus-visible,
+.stable-window-marker:focus-visible {
+  border-color: var(--flow);
+  outline: 2px solid #1e5c58;
+  outline-offset: 1px;
+}
+
+:where(button, input, select, textarea, a, [tabindex]):focus-visible {
+  outline: 3px solid var(--flow) !important;
+  outline-offset: 2px !important;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+}
+
+@media (max-width: 1100px) {
+  .app-shell {
+    grid-template-areas:
+      "header"
+      "scene"
+      "tabs"
+      "compact-panel";
+    grid-template-columns: minmax(0, 1fr);
+    grid-template-rows: auto minmax(24rem, 58vh) 48px auto;
+  }
+
+  .compact-panel-tabs {
+    grid-area: tabs;
+    z-index: 6;
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    min-width: 0;
+    border-top: 1px solid #294049;
+    border-bottom: 1px solid #294049;
+    background: var(--panel);
+  }
+
+  .compact-panel-tabs button {
+    min-width: 44px;
+    min-height: 44px;
+    border: 0;
+    border-right: 1px solid #294049;
+    color: var(--muted);
+    background: var(--panel);
+    cursor: pointer;
+  }
+
+  .compact-panel-tabs button[aria-selected="true"] {
+    color: var(--flow);
+    box-shadow: inset 0 -3px 0 var(--flow);
+  }
+
+  .tutorial-rail,
+  .control-panel,
+  .chart-drawer {
+    display: none;
+    grid-area: compact-panel;
+    border: 0;
+    min-width: 0;
+    max-width: 100vw;
+    overflow: auto;
+  }
+
+  .tutorial-rail[data-compact-active="true"],
+  .control-panel[data-compact-active="true"],
+  .chart-drawer[data-compact-active="true"] {
+    display: block;
+  }
+
+  .scene-hotspots {
+    grid-template-columns: 1fr;
+  }
+
+  .scene-hotspot-buttons {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .condition-summary-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .report-heading,
+  .report-panel {
+    align-items: stretch;
+    flex-direction: column;
+  }
+}
+
+@media (max-width: 600px) {
+  .app-shell {
+    grid-template-rows: 52px 48vh 48px minmax(0, auto);
+  }
+
+  .topbar {
+    min-width: 0;
