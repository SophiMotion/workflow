+
+function useCompactViewport() {
+  vi.stubGlobal("matchMedia", vi.fn(() => ({
+    matches: true,
+    media: "(max-width: 1100px)",
+    onchange: null,
+    addEventListener: vi.fn(),
+    removeEventListener: vi.fn(),
+    addListener: vi.fn(),
+    removeListener: vi.fn(),
