+    })).toMatchObject({ name: "low", grid: [160, 64], particleCount: 300, chartRefreshHz: 5 });
+  });
+
+  it("selects the exact high and medium profiles", () => {
+    expect(selectQualityProfile({
+      viewportWidth: 1440,
+      hardwareConcurrency: 12,
+      reducedMotion: false,
+    })).toEqual({ name: "high", grid: [320, 128], particleCount: 1_400, chartRefreshHz: 10 });
+    expect(selectQualityProfile({
+      viewportWidth: 1024,
+      hardwareConcurrency: 8,
+      reducedMotion: false,
+    })).toEqual({ name: "medium", grid: [240, 96], particleCount: 900, chartRefreshHz: 10 });
+  });
+});
+
+describe("AdaptiveQualityController", () => {
+  it("degrades one level after three seconds of sustained slow frames", () => {
+    const changes: string[] = [];
+    const controller = new AdaptiveQualityController("high", (profile) => changes.push(profile.name));
+    for (let elapsed = 0; elapsed < 3_100; elapsed += 50) controller.recordFrame(50);
+    expect(changes).toEqual(["medium"]);
+  });
+
+  it("clears its window and requires another slow interval before degrading again", () => {
+    const changes: string[] = [];
+    const controller = new AdaptiveQualityController("high", (profile) => changes.push(profile.name));
+    for (let elapsed = 0; elapsed < 3_100; elapsed += 50) controller.recordFrame(50);
+    controller.setProfile("medium");
+    for (let elapsed = 0; elapsed < 2_900; elapsed += 50) controller.recordFrame(50);
+    expect(changes).toEqual(["medium"]);
+    for (let elapsed = 2_900; elapsed < 3_100; elapsed += 50) controller.recordFrame(50);
+    expect(changes).toEqual(["medium", "low"]);
+  });
+
+  it("does not emit per-frame events or degrade below low", () => {
+    const onChange = vi.fn();
+    const controller = new AdaptiveQualityController("low", onChange);
+    for (let elapsed = 0; elapsed < 6_200; elapsed += 50) controller.recordFrame(50);
+    expect(onChange).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/features/shell/quality.ts b/src/features/shell/quality.ts
new file mode 100644
index 0000000..06364af
--- /dev/null
+++ b/src/features/shell/quality.ts
@@ -0,0 +1,87 @@
+export type QualityProfile = {
+  name: "reduced" | "low" | "medium" | "high";
+  grid: readonly [number, number];
+  particleCount: number;
+  chartRefreshHz: number;
+};
+
+export type QualitySelectionInput = {
+  viewportWidth: number;
+  hardwareConcurrency: number;
+  reducedMotion: boolean;
+};
+
+const PROFILES = {
+  reduced: { name: "reduced", grid: [160, 64], particleCount: 0, chartRefreshHz: 5 },
+  low: { name: "low", grid: [160, 64], particleCount: 300, chartRefreshHz: 5 },
+  medium: { name: "medium", grid: [240, 96], particleCount: 900, chartRefreshHz: 10 },
+  high: { name: "high", grid: [320, 128], particleCount: 1_400, chartRefreshHz: 10 },
+} as const satisfies Record<QualityProfile["name"], QualityProfile>;
+
+const SLOW_FRAME_MS = 41.7;
+const SLOW_WINDOW_MS = 3_000;
+
+export function selectQualityProfile({
+  viewportWidth,
+  hardwareConcurrency,
+  reducedMotion,
+}: QualitySelectionInput): QualityProfile {
+  if (reducedMotion) return PROFILES.reduced;
+  if (viewportWidth < 600 || hardwareConcurrency <= 4) return PROFILES.low;
+  if (viewportWidth >= 1_200 && hardwareConcurrency >= 8) return PROFILES.high;
+  return PROFILES.medium;
+}
+
+export function qualityProfile(name: QualityProfile["name"]): QualityProfile {
+  return PROFILES[name];
+}
+
+export class AdaptiveQualityController {
+  private profileName: QualityProfile["name"];
+  private frameDurations: number[] = [];
+  private elapsedMs = 0;
+
+  constructor(
+    initialProfile: QualityProfile["name"],
+    private onChange: (profile: QualityProfile) => void,
+  ) {
+    this.profileName = initialProfile;
+  }
+
+  setOnChange(onChange: (profile: QualityProfile) => void): void {
+    this.onChange = onChange;
+  }
+
+  setProfile(profileName: QualityProfile["name"]): void {
+    this.profileName = profileName;
+    this.clearWindow();
+  }
+
+  recordFrame(durationMs: number): void {
+    if (!Number.isFinite(durationMs) || durationMs <= 0 || this.profileName === "low" || this.profileName === "reduced") {
+      return;
+    }
+
+    this.frameDurations.push(durationMs);
+    this.elapsedMs += durationMs;
+    if (this.elapsedMs < SLOW_WINDOW_MS) return;
+
+    const averageMs = this.elapsedMs / this.frameDurations.length;
+    if (averageMs > SLOW_FRAME_MS) {
+      this.profileName = this.profileName === "high" ? "medium" : "low";
+      const nextProfile = PROFILES[this.profileName];
+      this.clearWindow();
+      this.onChange(nextProfile);
+      return;
+    }
+
+    while (this.elapsedMs >= SLOW_WINDOW_MS && this.frameDurations.length > 1) {
+      this.elapsedMs -= this.frameDurations.shift()!;
+    }
+  }
+
+  private clearWindow(): void {
+    this.frameDurations = [];
+    this.elapsedMs = 0;
+  }
+}
diff --git a/src/features/sweep/sweepRunner.test.ts b/src/features/sweep/sweepRunner.test.ts
new file mode 100644
index 0000000..d7d474e
--- /dev/null
+++ b/src/features/sweep/sweepRunner.test.ts
@@ -0,0 +1,123 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { TelemetryFrame } from "../experiment/model";
+import { advanceSweep, createSweepState, retryFailedCondition } from "./sweepRunner";
+
+const frame = (
+  power: number,
+  quality: TelemetryFrame["quality"] = "stable",
+  sequence = power,
+): TelemetryFrame => ({
+  sequence,
+  simulationTimeMs: sequence * 50,
+  phase: quality === "stable" ? "stabilizing" : "ramping",
+  fanPowerPct: power,
+  rpm: power * 62,
+  windSpeedMps: power * 0.12,
+  underbodyPressurePa: -power,
+  verticalLoadN: power / 100,
+  quality,
+  provenance: "simulated",
+});
+
+function advanceFor(state: ReturnType<typeof createSweepState>, power: number, milliseconds: number) {
+  let next = state;
+  for (let elapsed = 0; elapsed < milliseconds; elapsed += 50) {
+    next = advanceSweep(next, frame(power, "stable", elapsed / 50), 50).state;
+  }
+  return next;
+}
+
+describe("three-condition sweep reducer", () => {
+  afterEach(() => vi.useRealTimers());
+
+  it("runs exactly 30, 60, and 90 percent in order", () => {
+    let state = createSweepState();
+    for (const power of [30, 60, 90]) {
+      state = advanceFor(state, power, 6_500);
+    }
+
+    expect(state.completedPowers).toEqual([30, 60, 90]);
+    expect(state.status).toBe("completed");
+    expect(Object.keys(state.samplesByPower).map(Number)).toEqual([30, 60, 90]);
+  });
+
+  it("requires 2,000 consecutive stable milliseconds then samples for 4,000 milliseconds", () => {
+    let state = createSweepState();
+    state = advanceFor(state, 30, 1_950);
+    expect(state).toMatchObject({ status: "stabilizing", stableMs: 1_950, samplingMs: 0 });
+
+    state = advanceSweep(state, frame(30, "transient"), 50).state;
+    expect(state.stableMs).toBe(0);
+    state = advanceFor(state, 30, 2_000);
+    expect(state).toMatchObject({ status: "sampling", stableMs: 2_000, samplingMs: 0 });
+
+    state = advanceFor(state, 30, 3_950);
+    expect(state).toMatchObject({ status: "sampling", samplingMs: 3_950 });
+    const transition = advanceSweep(state, frame(30), 50);
+    expect(transition.state).toMatchObject({ status: "ramping", commandedPowerPct: 60 });
+    expect(transition.commandPowerPct).toBe(60);
+    expect(transition.state.samplesByPower[30]).toHaveLength(80);
+  });
+
+  it("ignores a prior condition trailing frame completely", () => {
+    const state = advanceFor(createSweepState(), 30, 6_000);
+    expect(state.commandedPowerPct).toBe(60);
+    const unchanged = advanceSweep(state, frame(30), 2_000);
+
+    expect(unchanged.state).toBe(state);
+    expect(unchanged.commandPowerPct).toBeUndefined();
+    expect(state.conditionElapsedMs).toBe(0);
+  });
+
+  it("fails at 15,000 simulation milliseconds and retries only that condition", () => {
+    let state = advanceFor(createSweepState(), 30, 6_000);
+    const firstSamples = state.samplesByPower[30];
+    for (let elapsed = 0; elapsed < 15_000; elapsed += 50) {
+      state = advanceSweep(state, frame(60, "transient", elapsed / 50), 50).state;
+    }
+
+    expect(state).toMatchObject({ status: "failed", commandedPowerPct: 60, conditionElapsedMs: 15_000 });
+    expect(state.error).toContain("60%");
+    const retry = retryFailedCondition(state);
+    expect(retry).toMatchObject({
+      status: "ramping",
+      commandedPowerPct: 60,
+      stableMs: 0,
+      samplingMs: 0,
+      conditionElapsedMs: 0,
+      completedPowers: [30],
+    });
+    expect(retry.samplesByPower[30]).toBe(firstSamples);
+  });
+
+  it("is deterministic under fake system-time changes", () => {
+    vi.useFakeTimers();
+    vi.setSystemTime("2031-01-01T00:00:00Z");
+    const first = advanceFor(createSweepState(), 30, 2_000);
+    vi.setSystemTime("2099-12-31T23:59:59Z");
+    const second = advanceFor(createSweepState(), 30, 2_000);
+
+    expect(second).toEqual(first);
+  });
+
+  it.each([
+    ["NaN", Number.NaN],
+    ["positive infinity", Number.POSITIVE_INFINITY],
+    ["negative infinity", Number.NEGATIVE_INFINITY],
+    ["negative rollback", -50],
+    ["single-frame jump", 6_000],
+  ])("fails retryably without polluting timers for %s dt", (_label, dtMs) => {
+    const initial = createSweepState();
+    const failed = advanceSweep(initial, frame(30), dtMs).state;
+
+    expect(failed).toMatchObject({
+      status: "failed",
+      stableMs: 0,
+      samplingMs: 0,
+      conditionElapsedMs: 0,
+    });
+    expect(failed.error).toContain("无效仿真时间步");
+    expect(Number.isFinite(failed.stableMs)).toBe(true);
+    expect(retryFailedCondition(failed)).toMatchObject({ status: "ramping", error: null });
+  });
+});
diff --git a/src/features/sweep/sweepRunner.ts b/src/features/sweep/sweepRunner.ts
new file mode 100644
index 0000000..10c9590
--- /dev/null
+++ b/src/features/sweep/sweepRunner.ts
@@ -0,0 +1,157 @@
+import type { TelemetryFrame } from "../experiment/model";
+
+export const SWEEP_POWERS = [30, 60, 90] as const;
+export const REQUIRED_STABLE_MS = 2_000;
+export const REQUIRED_SAMPLING_MS = 4_000;
+export const CONDITION_TIMEOUT_MS = 15_000;
+export const MAX_SWEEP_STEP_MS = 1_000;
+
+export type SweepPower = (typeof SWEEP_POWERS)[number];
+export type SweepStatus = "idle" | "ramping" | "stabilizing" | "sampling" | "completed" | "failed";
+
+export type SweepState = {
+  status: SweepStatus;
+  conditionIndex: number;
+  commandedPowerPct: SweepPower;
+  stableMs: number;
+  samplingMs: number;
+  conditionElapsedMs: number;
+  completedPowers: number[];
+  samplesByPower: Partial<Record<SweepPower, TelemetryFrame[]>>;
+  error: string | null;
+};
+
+export type SweepTransition = {
+  state: SweepState;
+  commandPowerPct?: SweepPower;
+};
+
+export function createSweepState(): SweepState {
+  return {
+    status: "ramping",
+    conditionIndex: 0,
+    commandedPowerPct: SWEEP_POWERS[0],
+    stableMs: 0,
+    samplingMs: 0,
+    conditionElapsedMs: 0,
+    completedPowers: [],
+    samplesByPower: {},
+    error: null,
+  };
+}
+
+export function advanceSweep(state: SweepState, frame: TelemetryFrame, dtMs: number): SweepTransition {
+  if (state.status === "idle" || state.status === "completed" || state.status === "failed") {
+    return { state };
+  }
+  if (frame.fanPowerPct !== state.commandedPowerPct) {
+    return { state };
+  }
+
+  if (!isValidSweepDt(dtMs)) {
+    return {
+      state: {
+        ...state,
+        status: "failed",
+        error: `${state.commandedPowerPct}% 工况收到无效仿真时间步`,
+      },
+    };
+  }
+
+  const elapsed = dtMs;
+  const conditionElapsedMs = state.conditionElapsedMs + elapsed;
+
+  if (state.status === "sampling") {
+    const samplingMs = state.samplingMs + elapsed;
+    const samples = [...(state.samplesByPower[state.commandedPowerPct] ?? []), frame];
+    const samplingState: SweepState = {
+      ...state,
+      samplingMs,
+      conditionElapsedMs,
+      samplesByPower: { ...state.samplesByPower, [state.commandedPowerPct]: samples },
+    };
+
+    if (samplingMs < REQUIRED_SAMPLING_MS) return { state: samplingState };
+    return completeCondition(samplingState);
+  }
+
+  const stableMs = frame.quality === "stable" ? state.stableMs + elapsed : 0;
+  if (stableMs >= REQUIRED_STABLE_MS) {
+    return {
+      state: {
+        ...state,
+        status: "sampling",
+        stableMs: REQUIRED_STABLE_MS,
+        conditionElapsedMs,
+      },
+    };
+  }
+
+  if (conditionElapsedMs >= CONDITION_TIMEOUT_MS) {
+    return {
+      state: {
+        ...state,
+        status: "failed",
+        stableMs,
+        conditionElapsedMs,
+        error: `${state.commandedPowerPct}% 工况在 15 秒内未达到连续稳定判据`,
+      },
+    };
+  }
+
+  return {
+    state: {
+      ...state,
+      status: "stabilizing",
+      stableMs,
+      conditionElapsedMs,
+    },
+  };
+}
+
+export function isValidSweepDt(dtMs: number): boolean {
+  return Number.isFinite(dtMs) && dtMs >= 0 && dtMs <= MAX_SWEEP_STEP_MS;
+}
+
+export function retryFailedCondition(state: SweepState): SweepState {
+  if (state.status !== "failed") return state;
+  return {
+    ...state,
+    status: "ramping",
+    stableMs: 0,
+    samplingMs: 0,
+    conditionElapsedMs: 0,
+    samplesByPower: { ...state.samplesByPower, [state.commandedPowerPct]: [] },
+    error: null,
+  };
+}
+
+function completeCondition(state: SweepState): SweepTransition {
+  const completedPowers = [...state.completedPowers, state.commandedPowerPct];
+  const nextPower = SWEEP_POWERS[state.conditionIndex + 1];
+  if (nextPower === undefined) {
+    return {
+      state: {
+        ...state,
+        status: "completed",
+        completedPowers,
+        error: null,
+      },
+    };
+  }
+
+  return {
+    commandPowerPct: nextPower,
+    state: {
+      ...state,
+      status: "ramping",
+      conditionIndex: state.conditionIndex + 1,
+      commandedPowerPct: nextPower,
+      stableMs: 0,
+      samplingMs: 0,
+      conditionElapsedMs: 0,
+      completedPowers,
+      error: null,
+    },
+  };
+}
