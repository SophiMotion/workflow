+  label: string;
+  unit: string;
+  value(frame: TelemetryFrame): string;
+};
+
+const TELEMETRY: readonly TelemetryDefinition[] = [
+  { id: "rpm", label: "风扇转速", unit: "RPM", value: (frame) => frame.rpm.toFixed(0) },
+  { id: "wind", label: "来流速度", unit: "m/s", value: (frame) => frame.windSpeedMps.toFixed(2) },
