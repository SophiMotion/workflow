diff --git a/src/features/flow/flowRuntime.ts b/src/features/flow/flowRuntime.ts
new file mode 100644
index 0000000..edfd096
--- /dev/null
+++ b/src/features/flow/flowRuntime.ts
@@ -0,0 +1,145 @@
+import { labStore } from "../experiment/labStore";
+import { FlowWorkerError } from "./LbmWorkerClient";
+import type { FlowFieldFrame } from "./types";
+
+const FRAME_INTERVAL_MS = 100;
+
+export interface FlowClientLike {
+  requestFrame(inletVelocity: number, iterations?: number): Promise<FlowFieldFrame>;
+  restart(): Promise<void>;
+}
+
+export interface FlowRuntime {
+  stop(): void;
+  restart(): Promise<void>;
+}
+
+export function mapWindToLatticeVelocity(windSpeedMps: number): number {
+  return Math.min(0.08, Math.max(0, windSpeedMps / 12 * 0.08));
+}
+
+export function startFlowRuntime(client: FlowClientLike): FlowRuntime {
+  let stopped = false;
+  let pending = false;
+  let restarting = false;
+  let failed = false;
+  let recoveryUsed = false;
+  let velocityScale = 1;
+  let generation = 0;
+  let restartPromise: Promise<void> | null = null;
+
+  labStore.setState({ flowStatus: "loading", flowError: null });
+
+  const tick = async () => {
+    if (stopped || failed || pending || restarting || document.hidden) {
+      return;
+    }
+
+    pending = true;
+    const tickGeneration = generation;
+    const windSpeedMps = labStore.getState().telemetry.windSpeedMps;
+    const inletVelocity = mapWindToLatticeVelocity(windSpeedMps) * velocityScale;
+
+    try {
+      let nextFrame: FlowFieldFrame;
+      try {
+        nextFrame = await client.requestFrame(inletVelocity);
+      } catch (error) {
+        if (!isNumericalInstability(error) || recoveryUsed) {
+          throw error;
+        }
+
+        recoveryUsed = true;
+        velocityScale *= 0.8;
+        labStore.setState((state) => ({
+          eventLog: [
+            ...state.eventLog,
+            "二维教学 CFD 数值场异常：入口格点速度已降至 80%，正在重启求解器。",
+          ],
+        }));
+        await client.restart();
+        nextFrame = await client.requestFrame(inletVelocity * 0.8);
+      }
+
+      if (!stopped && tickGeneration === generation) {
+        labStore.setState({
+          flowField: nextFrame,
+          flowStatus: "ready",
+          flowError: null,
+        });
+      }
+    } catch (error) {
+      if (!stopped && tickGeneration === generation) {
+        failed = true;
+        labStore.setState({
+          flowStatus: "failed",
+          flowError: errorMessage(error),
+        });
+      }
+    } finally {
+      if (tickGeneration === generation) {
+        pending = false;
+      }
+    }
+  };
+
+  const timer = setInterval(() => {
+    void tick();
+  }, FRAME_INTERVAL_MS);
+
+  return {
+    stop() {
+      if (stopped) {
+        return;
+      }
+      stopped = true;
+      generation += 1;
+      clearInterval(timer);
+    },
+    restart() {
+      if (stopped) {
+        return Promise.reject(new Error("Flow runtime is stopped"));
+      }
+      if (restartPromise !== null) return restartPromise;
+
+      restarting = true;
+      const restartGeneration = generation + 1;
+      generation = restartGeneration;
+      failed = false;
+      recoveryUsed = false;
+      velocityScale = 1;
+      labStore.setState({ flowError: null });
+      restartPromise = (async () => {
+        try {
+          await client.restart();
+        } catch (error) {
+          if (!stopped && restartGeneration === generation) {
+            failed = true;
+            labStore.setState({
+              flowStatus: "failed",
+              flowError: errorMessage(error),
+            });
+          }
+          throw error;
+        } finally {
+          if (restartGeneration === generation) {
+            pending = false;
+            restarting = false;
+          }
+          restartPromise = null;
+        }
+      })();
+      return restartPromise;
+    },
+  };
+}
+
+function isNumericalInstability(error: unknown): boolean {
+  return error instanceof FlowWorkerError && error.code === "NON_FINITE_FIELD"
+    || (typeof error === "object" && error !== null && "code" in error
+      && error.code === "NON_FINITE_FIELD");
+}
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : "Unknown flow worker failure";
+}
diff --git a/src/features/flow/lbm.worker.ts b/src/features/flow/lbm.worker.ts
new file mode 100644
index 0000000..637461a
--- /dev/null
+++ b/src/features/flow/lbm.worker.ts
@@ -0,0 +1,115 @@
+/// <reference lib="webworker" />
+
+import { LbmSolver, NumericalInstabilityError } from "./lbmSolver";
+import { createCarProfileMask } from "./obstacleMask";
+import type { WorkerRequest, WorkerResponse } from "./LbmWorkerClient";
+import type { FlowFieldFrame } from "./types";
+
+type PostWorkerResponse = (response: WorkerResponse, transfer?: Transferable[]) => void;
+
+export function createLbmWorkerMessageHandler(postResponse: PostWorkerResponse) {
+  let solver: LbmSolver | null = null;
+  let disposed = false;
+
+  return (request: WorkerRequest): void => {
+    if (disposed) {
+      return;
+    }
+
+    if (request.type === "dispose") {
+      disposed = true;
+      solver = null;
+      return;
+    }
+
+    if (request.type === "init") {
+      try {
+        const { width, height } = request.config;
+        solver = new LbmSolver({
+          ...request.config,
+          obstacleMask: createCarProfileMask(width, height),
+        });
+        postResponse({ type: "ready" });
+      } catch (error) {
+        postFailure(postResponse, error);
+      }
+      return;
+    }
+
+    if (solver === null) {
+      postResponse({
+        type: "error",
+        requestId: request.requestId,
+        code: "WORKER_FAILURE",
+        message: "Flow worker has not been initialized",
+      });
+      return;
+    }
+
+    try {
+      solver.setInletVelocity(request.inletVelocity);
+      const outboundFrame = copyFrameForTransfer(solver.step(request.iterations));
+      const transfer = frameTransferList(outboundFrame);
+      postResponse({
+        type: "frame",
+        requestId: request.requestId,
+        frame: outboundFrame,
+      }, transfer);
+    } catch (error) {
+      postFailure(postResponse, error, request.requestId);
+    }
+  };
+}
+
+function copyFrameForTransfer(frame: FlowFieldFrame): FlowFieldFrame {
+  return {
+    width: frame.width,
+    height: frame.height,
+    speed: frame.speed.slice(),
+    pressure: frame.pressure.slice(),
+    vorticity: frame.vorticity.slice(),
+    velocityX: frame.velocityX.slice(),
+    velocityY: frame.velocityY.slice(),
+    provenance: "2d-teaching-cfd",
+  };
+}
+
+function frameTransferList(frame: FlowFieldFrame): Transferable[] {
+  return [
+    frame.speed.buffer,
+    frame.pressure.buffer,
+    frame.vorticity.buffer,
+    frame.velocityX.buffer,
+    frame.velocityY.buffer,
+  ];
+}
+
+function postFailure(
+  postResponse: PostWorkerResponse,
+  error: unknown,
+  requestId?: number,
+): void {
+  const numericalFailure = error instanceof NumericalInstabilityError
+    || (typeof error === "object" && error !== null && "code" in error
+      && error.code === "NON_FINITE_FIELD");
+  const message = error instanceof Error ? error.message : "Unknown flow worker failure";
+  postResponse({
+    type: "error",
+    ...(requestId === undefined ? {} : { requestId }),
+    code: numericalFailure ? "NON_FINITE_FIELD" : "WORKER_FAILURE",
+    message,
+  });
+}
+
+const workerScope = typeof WorkerGlobalScope !== "undefined" && self instanceof WorkerGlobalScope
+  ? self as DedicatedWorkerGlobalScope
+  : null;
+
+if (workerScope !== null) {
+  const handleMessage = createLbmWorkerMessageHandler((response, transfer = []) => {
+    workerScope.postMessage(response, transfer);
+  });
+  workerScope.onmessage = (event: MessageEvent<WorkerRequest>) => {
+    handleMessage(event.data);
+  };
+}
