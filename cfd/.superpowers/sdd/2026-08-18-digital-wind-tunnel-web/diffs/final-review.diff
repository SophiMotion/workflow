+import { describe, expect, it } from "vitest";
+import { experimentReducer, initialExperimentState } from "./experimentMachine";
+
+describe("experimentMachine", () => {
+  it("pauses and resumes the exact prior phase", () => {
+    const running = { ...initialExperimentState, phase: "sampling" as const };
+    const paused = experimentReducer(running, { type: "pause" });
+    expect(paused).toMatchObject({ phase: "paused", resumePhase: "sampling" });
+    expect(experimentReducer(paused, { type: "resume" }).phase).toBe("sampling");
+  });
+
+  it("reset always returns to idle", () => {
+    expect(experimentReducer({ phase: "completed", resumePhase: null }, { type: "reset" }))
+      .toEqual(initialExperimentState);
+  });
+});
diff --git a/src/features/experiment/experimentMachine.ts b/src/features/experiment/experimentMachine.ts
new file mode 100644
index 0000000..bda37b8
--- /dev/null
+++ b/src/features/experiment/experimentMachine.ts
@@ -0,0 +1,48 @@
+import type { ActiveRunPhase, RunPhase } from "./model";
+
+export type ExperimentState = {
+  phase: RunPhase;
+  resumePhase: ActiveRunPhase | null;
+};
+
+export type ExperimentEvent =
+  | { type: "start" }
+  | { type: "pause" }
+  | { type: "resume" }
+  | { type: "advance" }
+  | { type: "reset" };
+
+export const initialExperimentState: ExperimentState = { phase: "idle", resumePhase: null };
+
+const nextPhase: Record<ActiveRunPhase, RunPhase> = {
+  ramping: "stabilizing",
+  stabilizing: "sampling",
+  sampling: "completed",
+};
+
+export function experimentReducer(state: ExperimentState, event: ExperimentEvent): ExperimentState {
+  switch (event.type) {
+    case "start":
+      return state.phase === "idle" || state.phase === "completed"
+        ? { phase: "ramping", resumePhase: null }
+        : state;
+    case "pause":
+      return isActiveRunPhase(state.phase)
+        ? { phase: "paused", resumePhase: state.phase }
+        : state;
+    case "resume":
+      return state.phase === "paused" && state.resumePhase
+        ? { phase: state.resumePhase, resumePhase: null }
+        : state;
+    case "advance":
+      return isActiveRunPhase(state.phase)
+        ? { phase: nextPhase[state.phase], resumePhase: null }
+        : state;
+    case "reset":
+      return initialExperimentState;
+  }
+}
+
+function isActiveRunPhase(phase: RunPhase): phase is ActiveRunPhase {
+  return phase === "ramping" || phase === "stabilizing" || phase === "sampling";
+}
