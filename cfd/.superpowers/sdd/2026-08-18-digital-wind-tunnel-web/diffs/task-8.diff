+import { useMemo, useState } from "react";
+import {
+  CartesianGrid,
+  Line,
+  LineChart,
+  ReferenceArea,
+  ResponsiveContainer,
+  Tooltip,
+  XAxis,
+  YAxis,
+} from "recharts";
+import { useLabStore } from "../experiment/labStore";
+import { mapHistoryToChartData, type ChartPoint } from "./historyMapping";
+
+type SeriesKey = "rpm" | "windSpeedMps" | "pressurePa" | "loadN";
+
+const SERIES: readonly { key: SeriesKey; label: string; color: string }[] = [
+  { key: "windSpeedMps", label: "风速 m/s", color: "#50e3c2" },
+  { key: "rpm", label: "转速 RPM", color: "#7ea9ff" },
+  { key: "pressurePa", label: "压力 Pa", color: "#f2bd4f" },
+  { key: "loadN", label: "载荷 N", color: "#e8685f" },
+];
+
+type HistoryChartProps = {
+  onInspectStableWindow(): void;
+};
+
+export function HistoryChart({ onInspectStableWindow }: HistoryChartProps) {
+  const history = useLabStore((state) => state.history);
+  const data = useMemo(() => mapHistoryToChartData(history), [history]);
+  const stableWindow = useMemo(() => findStableWindow(data), [data]);
+  const [hiddenSeries, setHiddenSeries] = useState<ReadonlySet<SeriesKey>>(() => new Set());
+
+  const toggleSeries = (key: SeriesKey) => {
+    setHiddenSeries((current) => {
+      const next = new Set(current);
+      if (next.has(key)) next.delete(key);
+      else next.add(key);
+      return next;
+    });
+  };
+
+  return (
+    <div className="history-panel">
+      <div className="history-heading">
+        <div>
+          <p className="section-kicker">60 SECOND HISTORY</p>
+          <h2 id="history-title">实验曲线</h2>
+        </div>
+        <div className="chart-legend" aria-label="曲线显示选项">
+          {SERIES.map((series) => (
+            <button
+              type="button"
+              key={series.key}
+              aria-pressed={!hiddenSeries.has(series.key)}
+              onClick={() => toggleSeries(series.key)}
+            >
+              <span style={{ backgroundColor: series.color }} aria-hidden="true" />{series.label}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      <div className="history-chart-plot" aria-label="最近 60 秒遥测曲线">
+        {data.length === 0 && <p className="chart-empty">启动实验后将在此显示最近 60 秒数据。</p>}
+        {data.length > 0 && (
+          <ResponsiveContainer width="100%" height="100%" initialDimension={{ width: 800, height: 140 }}>
+            <LineChart data={data} margin={{ top: 10, right: 28, bottom: 2, left: 6 }}>
+              <CartesianGrid stroke="#20353d" vertical={false} />
+              <XAxis dataKey="timeSeconds" type="number" domain={["dataMin", "dataMax"]} tickFormatter={(value) => `${Number(value).toFixed(0)}s`} stroke="#80969d" />
+              <YAxis yAxisId="velocity" orientation="left" stroke="#50e3c2" width={42} />
+              <YAxis yAxisId="rpm" orientation="left" stroke="#7ea9ff" width={42} hide />
+              <YAxis yAxisId="pressure" orientation="right" stroke="#f2bd4f" width={42} />
+              <YAxis yAxisId="load" orientation="right" stroke="#e8685f" width={42} hide />
+              <Tooltip labelFormatter={(value) => `T+${Number(value).toFixed(2)} s`} />
+              {stableWindow && (
+                <ReferenceArea
+                  x1={stableWindow.start}
+                  x2={stableWindow.end}
+                  yAxisId="velocity"
+                  fill="#50e3c2"
+                  fillOpacity={0.08}
+                  strokeOpacity={0}
+                />
+              )}
+              <Line yAxisId="velocity" dataKey="windSpeedMps" name="风速 m/s" stroke="#50e3c2" dot={false} isAnimationActive={false} hide={hiddenSeries.has("windSpeedMps")} />
+              <Line yAxisId="rpm" dataKey="rpm" name="转速 RPM" stroke="#7ea9ff" dot={false} isAnimationActive={false} hide={hiddenSeries.has("rpm")} />
+              <Line yAxisId="pressure" dataKey="pressurePa" name="压力 Pa" stroke="#f2bd4f" dot={false} isAnimationActive={false} hide={hiddenSeries.has("pressurePa")} />
+              <Line yAxisId="load" dataKey="loadN" name="载荷 N" stroke="#e8685f" dot={false} isAnimationActive={false} hide={hiddenSeries.has("loadN")} />
+            </LineChart>
+          </ResponsiveContainer>
+        )}
+      </div>
+      {stableWindow && (
+        <button type="button" className="stable-window-marker" aria-label="标记稳定窗口" onClick={onInspectStableWindow}>
+          标记稳定窗口
+          <span>{stableWindow.start.toFixed(2)}–{stableWindow.end.toFixed(2)} s</span>
+        </button>
+      )}
+    </div>
+  );
+}
+
+function findStableWindow(data: readonly ChartPoint[]): { start: number; end: number } | null {
+  let bestStart = -1;
+  let bestEnd = -1;
+  let currentStart = -1;
+
+  data.forEach((point, index) => {
+    if (point.quality === "stable") {
+      if (currentStart < 0) currentStart = index;
+      if (bestStart < 0 || index - currentStart > bestEnd - bestStart) {
+        bestStart = currentStart;
+        bestEnd = index;
+      }
+    } else {
+      currentStart = -1;
+    }
+  });
+
+  if (bestStart < 0 || bestEnd < 0) return null;
+  return { start: data[bestStart]!.timeSeconds, end: data[bestEnd]!.timeSeconds };
+}
