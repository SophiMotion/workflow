+import { LESSONS, type LessonId, type TutorialMode } from "./lessonDefinitions";
+import { canCompleteLesson, completedLessonCount, type TutorialEvidence } from "./tutorialProgress";
+
+type TutorialRailProps = {
+  activeLesson: LessonId;
+  evidence: TutorialEvidence;
+  onAdvance(): void;
+  mode?: TutorialMode;
+  onLessonChange?(lesson: LessonId): void;
+  onFlowAnswer?(correct: boolean): void;
+};
+
+export function TutorialRail({ activeLesson, evidence, onAdvance, mode = "guided", onLessonChange, onFlowAnswer }: TutorialRailProps) {
+  const activeIndex = LESSONS.findIndex((lesson) => lesson.id === activeLesson);
+  const activeDefinition = LESSONS[activeIndex] ?? LESSONS[0]!;
+  const complete = canCompleteLesson(activeLesson, evidence);
+  const isFinalLesson = activeIndex === LESSONS.length - 1;
+
+  return (
+    <div className="tutorial-rail-content">
+      <p className="eyebrow">七章教学路径</p>
+      <p>进度 {completedLessonCount(evidence)} / {LESSONS.length}</p>
+      <ol>
+        {LESSONS.map((lesson, index) => {
+          const isComplete = canCompleteLesson(lesson.id, evidence);
+          const isLocked = mode === "guided" && !isComplete && index > activeIndex;
+          const isCurrent = lesson.id === activeLesson;
+          return (
+            <li key={lesson.id}>
+              <button
+                type="button"
+                className={isCurrent ? "lesson-current" : isComplete ? "lesson-complete" : isLocked ? "lesson-locked" : "lesson-available"}
+                aria-current={isCurrent ? "step" : undefined}
+                aria-disabled={isLocked || undefined}
+                onClick={() => !isLocked && onLessonChange?.(lesson.id)}
+              >
+                第 {lesson.ordinal} 章：{lesson.title}{isComplete ? "（已完成）" : isLocked ? "（未解锁）" : ""}
+              </button>
+            </li>
+          );
+        })}
+      </ol>
+      <section aria-labelledby="lesson-goal">
+        <h2 id="lesson-goal">第 {activeDefinition.ordinal} 章：{activeDefinition.title}</h2>
+        <p>{activeDefinition.goal}</p>
+        <p>{activeDefinition.completionHint}</p>
+        {activeLesson === "flow" && (
+          <fieldset className="flow-question" aria-label="流场判断题">
+            <legend>哪项描述符合当前教学求解器？</legend>
+            <label>
+              <input
+                type="radio"
+                name="flow-answer"
+                checked={evidence.flowAnswerCorrect}
+                onChange={() => onFlowAnswer?.(true)}
+              />
+              二维中心截面用于观察定性趋势，不代表完整三维工程 CFD
+            </label>
+            <label>
+              <input
+                type="radio"
+                name="flow-answer"
+                checked={false}
+                onChange={() => onFlowAnswer?.(false)}
+              />
+              当前场可直接作为量产车辆的三维气动结论
+            </label>
+            {evidence.flowAnswerCorrect && <p>回答正确，二维教学场用于观察趋势。</p>}
+          </fieldset>
+        )}
+        {!complete && <p>完成当前目标后可进入下一章。</p>}
+        {!isFinalLesson && <button type="button" disabled={!complete && mode === "guided"} onClick={onAdvance}>进入下一章</button>}
+        {isFinalLesson && <p>{complete ? "七章教程已完成。" : "完成本章目标即可完成教程。"}</p>}
+        {mode === "free" && <p>自由实验已开启，章节限制已解除。</p>}
+      </section>
+    </div>
+  );
+}
diff --git a/src/features/tutorial/tutorialProgress.ts b/src/features/tutorial/tutorialProgress.ts
new file mode 100644
index 0000000..33541c4
--- /dev/null
+++ b/src/features/tutorial/tutorialProgress.ts
@@ -0,0 +1,97 @@
+import { LESSONS, type LessonId } from "./lessonDefinitions";
+
+export type { LessonId, TutorialMode } from "./lessonDefinitions";
+
+export type TutorialEvidence = {
+  viewedHotspots: string[];
+  stableSeconds: number;
+  viewedSensors: string[];
+  inspectedStableWindow: boolean;
+  viewedFields: string[];
+  flowAnswerCorrect: boolean;
+  completedSweepPowers: number[];
+  selectedLargestResidual: boolean;
+  reportConclusion: string;
+};
+
+export const emptyEvidence: TutorialEvidence = {
+  viewedHotspots: [],
+  stableSeconds: 0,
+  viewedSensors: [],
+  inspectedStableWindow: false,
+  viewedFields: [],
+  flowAnswerCorrect: false,
+  completedSweepPowers: [],
+  selectedLargestResidual: false,
+  reportConclusion: "",
+};
+
+const requiredHotspots = ["straightener", "contraction", "test-section", "model-stand", "fan"];
+const requiredSensors = ["rpm", "wind", "pressure", "load"];
+const requiredFields = ["speed", "pressure", "vorticity", "streamlines"];
+const requiredSweepPowers = [30, 60, 90];
+
+function includesAll<T>(values: readonly T[], required: readonly T[]) {
+  return required.every((value) => values.includes(value));
+}
+
+function hasExactSweepPowers(powers: readonly number[]) {
+  return powers.length === requiredSweepPowers.length
+    && requiredSweepPowers.every((power, index) => powers[index] === power);
+}
+
+export function recordSweepCompletion(
+  evidence: TutorialEvidence,
+  completedSweepPowers: readonly number[],
+): TutorialEvidence {
+  return { ...evidence, completedSweepPowers: [...completedSweepPowers] };
+}
+
+export function recordLargestResidualSelection(
+  evidence: TutorialEvidence,
+  selectedPower: number,
+  largestResidualPower: number,
+): TutorialEvidence {
+  return { ...evidence, selectedLargestResidual: selectedPower === largestResidualPower };
+}
+
+export function recordReportConclusion(evidence: TutorialEvidence, reportConclusion: string): TutorialEvidence {
+  return { ...evidence, reportConclusion };
+}
+
+export function recordFlowAnswer(evidence: TutorialEvidence, correct: boolean): TutorialEvidence {
+  return { ...evidence, flowAnswerCorrect: correct };
+}
+
+export function canCompleteLesson(lessonId: LessonId, evidence: TutorialEvidence): boolean {
+  switch (lessonId) {
+    case "anatomy":
+      return includesAll(evidence.viewedHotspots, requiredHotspots);
+    case "fan":
+      // The controller only accrues stableSeconds while the command is 30%.
+      return evidence.stableSeconds >= 2;
+    case "sensors":
+      return includesAll(evidence.viewedSensors, requiredSensors) && evidence.inspectedStableWindow;
+    case "flow":
+      return includesAll(evidence.viewedFields, requiredFields) && evidence.flowAnswerCorrect;
+    case "sweep":
+      return hasExactSweepPowers(evidence.completedSweepPowers);
+    case "compare":
+      return evidence.selectedLargestResidual;
+    case "report":
+      return includesAll(evidence.completedSweepPowers, requiredSweepPowers)
+        && evidence.reportConclusion.trim().length >= 12;
+  }
+}
+
+export function advanceLesson(activeLesson: LessonId, evidence: TutorialEvidence): LessonId {
+  const activeIndex = LESSONS.findIndex((lesson) => lesson.id === activeLesson);
+  if (!canCompleteLesson(activeLesson, evidence) || activeIndex < 0 || activeIndex === LESSONS.length - 1) {
+    return activeLesson;
+  }
+  return LESSONS[activeIndex + 1]!.id;
+}
+
+export function completedLessonCount(evidence: TutorialEvidence): number {
+  return LESSONS.filter((lesson) => canCompleteLesson(lesson.id, evidence)).length;
+}
diff --git a/src/features/report/ExperimentReport.tsx b/src/features/report/ExperimentReport.tsx
new file mode 100644
index 0000000..d37c162
--- /dev/null
+++ b/src/features/report/ExperimentReport.tsx
@@ -0,0 +1,287 @@
+import { useMemo, useState } from "react";
+import type { SweepState, SweepPower } from "../sweep/sweepRunner";
+import { SWEEP_POWERS } from "../sweep/sweepRunner";
+import {
+  downloadExperimentCsv,
+  serializeExperimentCsv,
+  type ExperimentCsvInput,
+} from "./csv";
+import { summarizeRun, type RunSummary } from "./experimentSummary";
+
+type DownloadCsv = (csv: string, generatedTime?: string) => unknown;
+
+export type ExperimentReportProps = {
+  sweep: SweepState | null;
+  conclusion: string;
+  onConclusionChange(value: string): void;
+  onSelectLargestResidual(power: SweepPower, largestPower: SweepPower): void;
+  onStartSweep(): void;
+  onCancelSweep(): void;
+  onRetrySweep(): void;
+  generatedTime?: string;
+  downloadCsv?: DownloadCsv;
+  serializeCsv?: (input: ExperimentCsvInput) => string;
+};
+
+type ConditionResult = {
+  power: SweepPower;
+  summary: RunSummary;
+  residual: number | null;
+};
+
+export function ExperimentReport(props: ExperimentReportProps) {
+  const conditions = useMemo(() => buildConditionResults(props.sweep), [props.sweep]);
+  const largestResidualPower = findLargestResidualPower(conditions);
+
+  return (
+    <section className="experiment-report" aria-labelledby="experiment-report-title">
+      <div className="report-heading">
+        <div>
+          <p className="section-kicker">AUTOMATED SWEEP &amp; REPORT</p>
+          <h2 id="experiment-report-title">三工况实验报告</h2>
+        </div>
+        <div className="report-disclaimers">
+          <span>SIMULATED / 模拟数据</span>
+          <span>2D TEACHING CFD / 二维教学近似</span>
+        </div>
+      </div>
+
+      <SweepPanel
+        sweep={props.sweep}
+        onStart={props.onStartSweep}
+        onCancel={props.onCancelSweep}
+        onRetry={props.onRetrySweep}
+      />
+      <div className="condition-summary-grid">
+        {conditions.map(({ power, summary }) => <ConditionCard key={power} power={power} summary={summary} />)}
+      </div>
+      <ComparisonTable
+        conditions={conditions}
+        largestResidualPower={largestResidualPower}
+        onSelect={(power) => {
+          if (largestResidualPower !== null) props.onSelectLargestResidual(power, largestResidualPower);
+        }}
+      />
+      <ReportPanel {...props} />
+    </section>
+  );
+}
+
+export function SweepPanel({
+  sweep,
+  onStart,
+  onCancel,
+  onRetry,
+}: Pick<ExperimentReportProps, "sweep"> & {
+  onStart(): void;
+  onCancel(): void;
+  onRetry(): void;
+}) {
+  const active = sweep !== null && ["ramping", "stabilizing", "sampling"].includes(sweep.status);
+  const label = sweep === null ? "未开始" : statusLabel(sweep);
+
+  return (
+    <div className="sweep-panel">
+      <div>
+        <strong>固定序列 30% → 60% → 90%</strong>
+        <span>{label}</span>
+      </div>
+      <div className="sweep-actions">
+        <button type="button" disabled={active} onClick={onStart}>
+          {sweep === null ? "开始自动扫频" : "重新运行扫频"}
+        </button>
+        {active && <button type="button" onClick={onCancel}>取消扫频</button>}
+        {sweep?.status === "failed" && <button type="button" onClick={onRetry}>重试当前工况</button>}
+      </div>
+      {sweep?.error && <p className="sweep-error" role="alert">{sweep.error}</p>}
+    </div>
+  );
+}
+
+export function ComparisonTable({
+  conditions,
+  largestResidualPower,
+  onSelect,
+}: {
+  conditions: ConditionResult[];
+  largestResidualPower: SweepPower | null;
+  onSelect(power: SweepPower): void;
+}) {
+  return (
+    <section className="comparison-panel" aria-labelledby="comparison-title">
+      <div className="comparison-heading">
+        <h3 id="comparison-title">残差对比</h3>
+        <p>观察趋势：风速增大时，动压与垂向载荷近似按 v² 增长。</p>
+      </div>
+      <div className="comparison-table-wrap">
+        <table>
+          <thead><tr><th>工况</th><th>平均风速</th><th>平均载荷</th><th>|v² 基线残差|</th><th>判断</th></tr></thead>
+          <tbody>
+            {conditions.map(({ power, summary, residual }) => (
+              <tr key={power}>
+                <th scope="row">{power}%</th>
+                <td>{format(summary.windSpeedMps.mean, 2)} m/s</td>
+                <td>{format(summary.verticalLoadN.mean, 3)} N</td>
+                <td>{format(residual, 5)} N</td>
+                <td><label><input
+                  type="radio"
+                  name="largest-residual"
+                  disabled={largestResidualPower === null}
+                  aria-label={`${power}% 为最大残差`}
+                  onChange={() => onSelect(power)}
+                /> 选择</label></td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </section>
+  );
+}
+
+export function ReportPanel({
+  sweep,
+  conclusion,
+  onConclusionChange,
+  generatedTime,
+  downloadCsv = downloadExperimentCsv,
+  serializeCsv = serializeExperimentCsv,
+}: ExperimentReportProps) {
+  const [failedSnapshot, setFailedSnapshot] = useState<ExportSnapshot | null>(null);
+  const remainingCharacters = Math.max(0, 12 - conclusion.trim().length);
+  const canExport = sweep?.status === "completed" && remainingCharacters === 0;
+
+  const runExport = (snapshot: ExportSnapshot) => {
+    let csv = snapshot.csv;
+    if (csv === undefined) {
+      try {
+        csv = serializeCsv(snapshot.input);
+      } catch {
+        setFailedSnapshot(snapshot);
+        return;
+      }
+    }
+    const serializedSnapshot = { ...snapshot, csv };
+    try {
+      downloadCsv(csv, snapshot.generatedTime);
+      setFailedSnapshot(null);
+    } catch {
+      setFailedSnapshot(serializedSnapshot);
+    }
+  };
+
+  const exportReport = () => {
+    if (!sweep) return;
+    const snapshotTime = generatedTime ?? new Date().toISOString();
+    const samples = SWEEP_POWERS.flatMap((power) => (
+      (sweep.samplesByPower[power] ?? []).map((sample) => ({ ...sample }))
+    ));
+    const input: ExperimentCsvInput = {
+      metadata: { generatedTime: snapshotTime, conclusion, provenance: "simulated" },
+      samples,
+    };
+    runExport({ input, generatedTime: snapshotTime });
+  };
+
+  return (
+    <section className="report-panel" aria-labelledby="conclusion-title">
+      <div>
+        <label id="conclusion-title" htmlFor="experiment-conclusion">实验结论</label>
+        <textarea
+          id="experiment-conclusion"
+          value={conclusion}
+          minLength={12}
+          rows={3}
+          onChange={(event) => onConclusionChange(event.currentTarget.value)}
+        />
+        <small>{remainingCharacters > 0 ? `还需 ${remainingCharacters} 个字符` : "已满足至少 12 个字符"}</small>
+      </div>
+      <div className="report-actions">
+        <button type="button" onClick={() => window.print()}>打印报告</button>
+        <button type="button" disabled={!canExport} onClick={exportReport}>导出 CSV</button>
+        {failedSnapshot && <button type="button" onClick={() => runExport(failedSnapshot)}>重试导出</button>}
+      </div>
+      {failedSnapshot && <p className="export-error" role="alert">导出失败，实验数据仍保留</p>}
+    </section>
+  );
+}
+
+type ExportSnapshot = {
+  input: ExperimentCsvInput;
+  generatedTime: string;
+  csv?: string;
+};
+
+function ConditionCard({ power, summary }: { power: SweepPower; summary: RunSummary }) {
+  return (
+    <article className="condition-card">
+      <div><h3>{power}%</h3><span className={summary.valid ? "summary-valid" : "summary-invalid"}>{summary.valid ? "有效" : "无效"}</span></div>
+      <dl>
+        <dt>稳定样本</dt><dd>{summary.sampleCount}</dd>
+        <dt>RPM avg ± std</dt><dd>{format(summary.rpm.mean, 0)} ± {format(summary.rpm.standardDeviation, 0)} RPM</dd>
+        <dt>RPM min–max</dt><dd>{format(summary.rpm.min, 0)}–{format(summary.rpm.max, 0)} RPM</dd>
+        <dt>风速 avg ± std</dt><dd>{format(summary.windSpeedMps.mean, 2)} ± {format(summary.windSpeedMps.standardDeviation, 2)} m/s</dd>
+        <dt>风速 min–max</dt><dd>{format(summary.windSpeedMps.min, 2)}–{format(summary.windSpeedMps.max, 2)} m/s</dd>
+        <dt>压力 avg ± std</dt><dd>{format(summary.underbodyPressurePa.mean, 1)} ± {format(summary.underbodyPressurePa.standardDeviation, 1)} Pa</dd>
+        <dt>压力 min–max</dt><dd>{format(summary.underbodyPressurePa.min, 1)}–{format(summary.underbodyPressurePa.max, 1)} Pa</dd>
+        <dt>载荷 avg ± std</dt><dd>{format(summary.verticalLoadN.mean, 3)} ± {format(summary.verticalLoadN.standardDeviation, 3)} N</dd>
+        <dt>载荷 min–max</dt><dd>{format(summary.verticalLoadN.min, 3)}–{format(summary.verticalLoadN.max, 3)} N</dd>
+      </dl>
+    </article>
+  );
+}
+
+function buildConditionResults(sweep: SweepState | null): ConditionResult[] {
+  const baseSummaries = SWEEP_POWERS.map((power) => ({
+    power,
+    summary: summarizeRun(sweep?.samplesByPower[power] ?? []),
+  }));
+  const comparisonReady = sweep?.status === "completed"
+    && baseSummaries.every(({ summary }) => summary.valid);
+  const baseline = baseSummaries[0]!.summary;
+  const baselineWind = baseline.windSpeedMps.mean;
+  const baselineLoad = baseline.verticalLoadN.mean;
+  if (!comparisonReady
+    || !isFiniteNumber(baselineWind)
+    || !isFiniteNumber(baselineLoad)
+    || baselineWind === 0) {
+    return baseSummaries.map(({ power, summary }) => ({ power, summary, residual: null }));
+  }
+
+  const compared = baseSummaries.map(({ power, summary }) => {
+    const wind = summary.windSpeedMps.mean;
+    const load = summary.verticalLoadN.mean;
+    if (!isFiniteNumber(wind) || !isFiniteNumber(load)) return { power, summary, residual: null };
+    const expected = baselineLoad * (wind / baselineWind) ** 2;
+    const residual = Math.abs(load - expected);
+    return { power, summary, residual: Number.isFinite(residual) ? residual : null };
+  });
+  return compared.every(({ residual }) => residual !== null)
+    ? compared
+    : compared.map(({ power, summary }) => ({ power, summary, residual: null }));
+}
+
+function findLargestResidualPower(conditions: ConditionResult[]): SweepPower | null {
+  const available = conditions.filter((condition) => condition.residual !== null);
+  if (available.length === 0) return null;
+  return available.reduce((largest, condition) => condition.residual! > largest.residual! ? condition : largest).power;
+}
+
+function statusLabel(sweep: SweepState): string {
+  switch (sweep.status) {
+    case "ramping": return `${sweep.commandedPowerPct}%：正在下发功率`;
+    case "stabilizing": return `${sweep.commandedPowerPct}%：稳定 ${sweep.stableMs / 1_000}/2.0 s`;
+    case "sampling": return `${sweep.commandedPowerPct}%：采样 ${sweep.samplingMs / 1_000}/4.0 s`;
+    case "completed": return "30%、60%、90% 均已完成";
+    case "failed": return `${sweep.commandedPowerPct}%：稳定超时`;
+    case "idle": return "未开始";
+  }
+}
+
+function format(value: number | null, digits: number): string {
+  return value === null ? "—" : value.toFixed(digits);
+}
+
+function isFiniteNumber(value: number | null): value is number {
+  return value !== null && Number.isFinite(value);
+}
diff --git a/src/features/report/ExperimentReport.test.tsx b/src/features/report/ExperimentReport.test.tsx
new file mode 100644
index 0000000..8003bd0
--- /dev/null
+++ b/src/features/report/ExperimentReport.test.tsx
@@ -0,0 +1,276 @@
+import { render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { expect, it, vi } from "vitest";
+import type { TelemetryFrame } from "../experiment/model";
+import type { SweepState } from "../sweep/sweepRunner";
+import { ExperimentReport } from "./ExperimentReport";
+import type { ExperimentCsvInput } from "./csv";
+
+function samples(power: 30 | 60 | 90, wind: number, load: number): TelemetryFrame[] {
+  return Array.from({ length: 80 }, (_, sequence) => ({
+    sequence,
+    simulationTimeMs: power * 1_000 + sequence * 50,
+    phase: "sampling",
+    fanPowerPct: power,
+    rpm: power * 62,
+    windSpeedMps: wind,
+    underbodyPressurePa: -power,
+    verticalLoadN: load,
+    quality: "stable",
+    provenance: "simulated",
+  }));
+}
+
+const completedSweep: SweepState = {
+  status: "completed",
+  conditionIndex: 2,
