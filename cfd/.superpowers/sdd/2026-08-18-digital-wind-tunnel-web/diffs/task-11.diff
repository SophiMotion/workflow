+import { expect, test, type Page } from "@playwright/test";
+
+test("free lab supports run controls, field switching, reset, and context recovery", async ({ page }) => {
+  const errors: string[] = [];
+  page.on("pageerror", (error) => errors.push(`pageerror: ${error.message}`));
+  page.on("console", (message) => {
+    if (message.type() === "error") errors.push(`console: ${message.text()}`);
+  });
+
+  await page.goto("/");
+  await page.getByRole("button", { name: "自由实验" }).click();
+  await page.getByLabel("风扇功率").fill("42");
+  await page.getByRole("button", { name: "启动实验" }).click();
+  await expect(page.getByText(/升速中/)).toBeVisible();
+
+  await page.getByRole("button", { name: "暂停实验" }).click();
+  await expect(page.getByText(/已暂停/)).toBeVisible();
+  await page.getByRole("button", { name: "继续实验" }).click();
+  await expect(page.getByText(/升速中/)).toBeVisible();
+
+  await page.getByRole("radio", { name: "压力", exact: true }).click();
+  await expect(page.getByRole("radio", { name: "压力", exact: true })).toHaveAttribute("aria-checked", "true");
+
+  const canvas = page.locator(".scene-canvas canvas");
+  if (await canvas.count()) {
+    await canvas.dispatchEvent("webglcontextlost");
+    await expect(page.getByText(/三维上下文已丢失/)).toBeVisible();
+    await canvas.dispatchEvent("webglcontextrestored");
+    await expect(page.getByText(/三维上下文已丢失/)).toBeHidden();
+  }
+
+  page.once("dialog", (dialog) => dialog.accept());
+  await page.getByRole("button", { name: "停止并重置" }).click();
+  await expect(page.getByText("待机 / IDLE")).toBeVisible();
+  await expect(page.getByLabel("风扇功率")).toHaveValue("0");
+  expect(errors).toEqual([]);
+});
