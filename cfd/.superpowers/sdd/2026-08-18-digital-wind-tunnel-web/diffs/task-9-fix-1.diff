+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { TelemetryFrame } from "../experiment/model";
+import { advanceSweep, createSweepState, retryFailedCondition } from "./sweepRunner";
+
+const frame = (
+  power: number,
+  quality: TelemetryFrame["quality"] = "stable",
+  sequence = power,
+): TelemetryFrame => ({
+  sequence,
+  simulationTimeMs: sequence * 50,
+  phase: quality === "stable" ? "stabilizing" : "ramping",
+  fanPowerPct: power,
+  rpm: power * 62,
+  windSpeedMps: power * 0.12,
+  underbodyPressurePa: -power,
+  verticalLoadN: power / 100,
+  quality,
+  provenance: "simulated",
+});
+
+function advanceFor(state: ReturnType<typeof createSweepState>, power: number, milliseconds: number) {
+  let next = state;
+  for (let elapsed = 0; elapsed < milliseconds; elapsed += 50) {
+    next = advanceSweep(next, frame(power, "stable", elapsed / 50), 50).state;
+  }
+  return next;
+}
+
+describe("three-condition sweep reducer", () => {
+  afterEach(() => vi.useRealTimers());
+
+  it("runs exactly 30, 60, and 90 percent in order", () => {
+    let state = createSweepState();
+    for (const power of [30, 60, 90]) {
+      state = advanceFor(state, power, 6_500);
+    }
+
+    expect(state.completedPowers).toEqual([30, 60, 90]);
+    expect(state.status).toBe("completed");
+    expect(Object.keys(state.samplesByPower).map(Number)).toEqual([30, 60, 90]);
+  });
+
+  it("requires 2,000 consecutive stable milliseconds then samples for 4,000 milliseconds", () => {
+    let state = createSweepState();
+    state = advanceFor(state, 30, 1_950);
+    expect(state).toMatchObject({ status: "stabilizing", stableMs: 1_950, samplingMs: 0 });
+
+    state = advanceSweep(state, frame(30, "transient"), 50).state;
+    expect(state.stableMs).toBe(0);
+    state = advanceFor(state, 30, 2_000);
+    expect(state).toMatchObject({ status: "sampling", stableMs: 2_000, samplingMs: 0 });
+
+    state = advanceFor(state, 30, 3_950);
+    expect(state).toMatchObject({ status: "sampling", samplingMs: 3_950 });
+    const transition = advanceSweep(state, frame(30), 50);
+    expect(transition.state).toMatchObject({ status: "ramping", commandedPowerPct: 60 });
+    expect(transition.commandPowerPct).toBe(60);
+    expect(transition.state.samplesByPower[30]).toHaveLength(80);
+  });
+
+  it("ignores a prior condition trailing frame completely", () => {
+    const state = advanceFor(createSweepState(), 30, 6_000);
+    expect(state.commandedPowerPct).toBe(60);
+    const unchanged = advanceSweep(state, frame(30), 2_000);
+
+    expect(unchanged.state).toBe(state);
+    expect(unchanged.commandPowerPct).toBeUndefined();
+    expect(state.conditionElapsedMs).toBe(0);
+  });
+
+  it("fails at 15,000 simulation milliseconds and retries only that condition", () => {
+    let state = advanceFor(createSweepState(), 30, 6_000);
+    const firstSamples = state.samplesByPower[30];
+    for (let elapsed = 0; elapsed < 15_000; elapsed += 50) {
+      state = advanceSweep(state, frame(60, "transient", elapsed / 50), 50).state;
+    }
+
+    expect(state).toMatchObject({ status: "failed", commandedPowerPct: 60, conditionElapsedMs: 15_000 });
+    expect(state.error).toContain("60%");
+    const retry = retryFailedCondition(state);
+    expect(retry).toMatchObject({
+      status: "ramping",
+      commandedPowerPct: 60,
+      stableMs: 0,
+      samplingMs: 0,
+      conditionElapsedMs: 0,
+      completedPowers: [30],
+    });
+    expect(retry.samplesByPower[30]).toBe(firstSamples);
+  });
+
+  it("is deterministic under fake system-time changes", () => {
+    vi.useFakeTimers();
+    vi.setSystemTime("2031-01-01T00:00:00Z");
+    const first = advanceFor(createSweepState(), 30, 2_000);
+    vi.setSystemTime("2099-12-31T23:59:59Z");
+    const second = advanceFor(createSweepState(), 30, 2_000);
+
+    expect(second).toEqual(first);
+  });
+
+  it.each([
+    ["NaN", Number.NaN],
+    ["positive infinity", Number.POSITIVE_INFINITY],
+    ["negative infinity", Number.NEGATIVE_INFINITY],
+    ["negative rollback", -50],
+    ["single-frame jump", 6_000],
+  ])("fails retryably without polluting timers for %s dt", (_label, dtMs) => {
+    const initial = createSweepState();
+    const failed = advanceSweep(initial, frame(30), dtMs).state;
+
+    expect(failed).toMatchObject({
+      status: "failed",
+      stableMs: 0,
+      samplingMs: 0,
+      conditionElapsedMs: 0,
+    });
+    expect(failed.error).toContain("无效仿真时间步");
+    expect(Number.isFinite(failed.stableMs)).toBe(true);
+    expect(retryFailedCondition(failed)).toMatchObject({ status: "ramping", error: null });
+  });
+});
diff --git a/src/features/experiment/labStore.ts b/src/features/experiment/labStore.ts
new file mode 100644
index 0000000..748a98e
--- /dev/null
+++ b/src/features/experiment/labStore.ts
@@ -0,0 +1,141 @@
+import { useStore } from "zustand";
+import { createStore } from "zustand/vanilla";
+import { createDefaultSimulationSource } from "./SimulationSource";
+import { experimentReducer } from "./experimentMachine";
+import type { ActiveRunPhase, RunPhase, TelemetryFrame } from "./model";
+import type { FlowFieldFrame } from "../flow/types";
+import {
+  advanceSweep,
+  createSweepState,
+  isValidSweepDt,
+  retryFailedCondition,
+  type SweepState,
+} from "../sweep/sweepRunner";
+
+export const MAX_HISTORY = 1200;
+
+export type LabState = {
+  phase: RunPhase;
+  resumePhase: ActiveRunPhase | null;
+  fanPowerPct: number;
+  telemetry: TelemetryFrame;
+  history: TelemetryFrame[];
+  flowField: FlowFieldFrame | null;
+  flowStatus: "idle" | "loading" | "ready" | "failed";
+  flowError: string | null;
+  eventLog: string[];
+  selectedField: "speed" | "pressure" | "vorticity" | "streamlines";
+  sweep: SweepState | null;
+  setFanPower(percent: number): void;
+  acceptFrame(frame: TelemetryFrame): void;
+  startRun(): void;
+  pauseRun(): void;
+  resumeRun(): void;
+  advancePhase(): void;
+  resetLab(): void;
+  selectField(field: LabState["selectedField"]): void;
+  startSweep(): void;
+  cancelSweep(): void;
+  retrySweep(): void;
+};
+
+const initialTelemetry = createDefaultSimulationSource(0).reset();
+
+export const labStore = createStore<LabState>((set) => ({
+  phase: "idle",
+  resumePhase: null,
+  fanPowerPct: 0,
+  telemetry: initialTelemetry,
+  history: [],
+  flowField: null,
+  flowStatus: "idle",
+  flowError: null,
+  eventLog: [],
+  selectedField: "speed",
+  sweep: null,
+  setFanPower: (percent) => set((state) => isSweepActive(state.sweep)
+    ? state
+    : { fanPowerPct: Math.min(100, Math.max(0, percent)) }),
+  acceptFrame: (frame) => set((state) => {
+    if (!isSweepActive(state.sweep)) {
+      return {
+        telemetry: frame,
+        history: [...state.history.slice(-MAX_HISTORY + 1), frame],
+      };
+    }
+
+    const dtMs = frame.simulationTimeMs - state.telemetry.simulationTimeMs;
+    const transition = advanceSweep(state.sweep, frame, dtMs);
+    if (!isValidSweepDt(dtMs)) {
+      if (frame.fanPowerPct !== state.sweep.commandedPowerPct) return state;
+      return {
+        sweep: transition.state,
+        phase: "completed",
+        resumePhase: null,
+      };
+    }
+    return {
+      telemetry: frame,
+      history: [...state.history.slice(-MAX_HISTORY + 1), frame],
+      sweep: transition.state,
+      fanPowerPct: transition.commandPowerPct ?? state.fanPowerPct,
+      phase: sweepStatusToRunPhase(transition.state),
+      resumePhase: null,
+    };
+  }),
+  startRun: () => set((state) => isSweepActive(state.sweep) ? state : experimentReducer(state, { type: "start" })),
+  pauseRun: () => set((state) => isSweepActive(state.sweep) ? state : experimentReducer(state, { type: "pause" })),
+  resumeRun: () => set((state) => isSweepActive(state.sweep) ? state : experimentReducer(state, { type: "resume" })),
+  advancePhase: () => set((state) => isSweepActive(state.sweep) ? state : experimentReducer(state, { type: "advance" })),
+  resetLab: () => set({
+    phase: "idle",
+    resumePhase: null,
+    fanPowerPct: 0,
+    telemetry: initialTelemetry,
+    history: [],
+    flowField: null,
+    flowStatus: "idle",
+    flowError: null,
+    eventLog: [],
+    selectedField: "speed",
+    sweep: null,
+  }),
+  selectField: (selectedField) => set({ selectedField }),
+  startSweep: () => set((state) => isSweepActive(state.sweep) ? state : ({
+    sweep: createSweepState(),
+    fanPowerPct: 30,
+    phase: "ramping",
+    resumePhase: null,
+  })),
+  cancelSweep: () => set((state) => ({
+    sweep: state.sweep ? { ...state.sweep, status: "idle", error: null } : null,
+    fanPowerPct: 0,
+    phase: "idle",
+    resumePhase: null,
+  })),
+  retrySweep: () => set((state) => {
+    if (!state.sweep || state.sweep.status !== "failed") return state;
+    const sweep = retryFailedCondition(state.sweep);
+    return {
+      sweep,
+      fanPowerPct: sweep.commandedPowerPct,
+      phase: "ramping",
+      resumePhase: null,
+    };
+  }),
+}));
+
+export function useLabStore<T>(selector: (state: LabState) => T): T {
+  return useStore(labStore, selector);
+}
+
+function isSweepActive(sweep: SweepState | null): sweep is SweepState {
+  return sweep !== null && ["ramping", "stabilizing", "sampling"].includes(sweep.status);
+}
+
+function sweepStatusToRunPhase(sweep: SweepState): RunPhase {
+  if (sweep.status === "ramping" || sweep.status === "stabilizing" || sweep.status === "sampling") {
+    return sweep.status;
+  }
+  return "completed";
+}
diff --git a/src/features/experiment/labStore.test.ts b/src/features/experiment/labStore.test.ts
new file mode 100644
