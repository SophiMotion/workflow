+    conclusion=""
+    onConclusionChange={() => undefined}
+    onSelectLargestResidual={() => undefined}
+    onStartSweep={() => undefined}
+    onCancelSweep={() => undefined}
+    onRetrySweep={() => undefined}
+  />);
+
+  for (const radio of screen.getAllByRole("radio")) expect(radio).toBeDisabled();
+});
