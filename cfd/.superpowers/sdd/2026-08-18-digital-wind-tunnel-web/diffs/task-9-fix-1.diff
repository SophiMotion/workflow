+
+  rerender(<ExperimentReport
+    sweep={{ ...completedSweep, samplesByPower: {} }}
+    conclusion="被外部修改但不应进入重试快照"
+    generatedTime="2099-01-01T00:00:00.000Z"
+    downloadCsv={downloadCsv}
