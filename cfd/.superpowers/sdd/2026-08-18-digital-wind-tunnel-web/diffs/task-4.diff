+import { useState } from "react";
+import { AppShell } from "./features/shell/AppShell";
+import { TutorialModeToggle } from "./features/tutorial/TutorialModeToggle";
+import { TutorialRail } from "./features/tutorial/TutorialRail";
+import { advanceLesson, emptyEvidence } from "./features/tutorial/tutorialProgress";
+import type { LessonId, TutorialMode } from "./features/tutorial/lessonDefinitions";
+
+export function App() {
+  const [mode, setMode] = useState<TutorialMode>("guided");
+  const [activeLesson, setActiveLesson] = useState<LessonId>("anatomy");
+  const [evidence] = useState(emptyEvidence);
+
+  return (
+    <AppShell
+      headerActions={<TutorialModeToggle mode={mode} onModeChange={setMode} />}
+      left={<TutorialRail activeLesson={activeLesson} evidence={evidence} mode={mode} onLessonChange={setActiveLesson} onAdvance={() => setActiveLesson(advanceLesson(activeLesson, evidence))} />}
+      scene={<p>数字风洞场景将在此处呈现。</p>}
+      right={<p>实验控制将在此处呈现。</p>}
+      bottom={<p>实验曲线将在此处呈现。</p>}
+    />
+  );
+}
