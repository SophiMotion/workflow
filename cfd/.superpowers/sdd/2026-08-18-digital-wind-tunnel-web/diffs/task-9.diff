+
+.report-panel > div:first-child {
+  flex: 1;
+}
+
+.report-panel label,
+.report-panel small {
+  display: block;
+  color: var(--muted);
+  font-size: 0.62rem;
+}
+
+.report-panel textarea {
+  width: 100%;
+  margin: 0.3rem 0;
+  padding: 0.45rem;
+  border: 1px solid #34505a;
+  color: var(--ink);
+  background: #071014;
+  resize: vertical;
+}
+
+@media print {
+  .topbar,
+  .tutorial-rail,
+  .scene-panel,
+  .control-panel,
+  .history-panel,
+  .sweep-actions,
+  .report-actions {
+    display: none !important;
+  }
+
+  .app-shell,
+  .chart-drawer {
+    display: block;
+    color: #111;
+    background: #fff;
+  }
+
+  .experiment-report,
+  .condition-card,
+  .comparison-panel,
+  .report-panel {
+    border-color: #aaa;
+    color: #111;
+    background: #fff;
+  }
+}
+
+.experiment-actions button:hover:not(:disabled),
+.field-options button:hover,
+.telemetry-quality button:hover,
+.chart-legend button:hover,
+.stable-window-marker:hover,
+.experiment-actions button:focus-visible,
+.field-options button:focus-visible,
+.telemetry-quality button:focus-visible,
+.chart-legend button:focus-visible,
+.stable-window-marker:focus-visible {
+  border-color: var(--flow);
+  outline: 2px solid #1e5c58;
+  outline-offset: 1px;
+}
+
+@media (max-width: 900px) {
+  .app-shell {
+    grid-template-areas:
+      "header"
+      "scene"
+      "left"
+      "right"
+      "bottom";
+    grid-template-columns: minmax(0, 1fr);
+    grid-template-rows: auto minmax(18rem, 1fr) auto auto 220px;
+  }
+
+  .tutorial-rail,
+  .control-panel {
+    border: 0;
+    border-top: 1px solid var(--panel-raised);
+  }
+
+  .scene-hotspots {
+    grid-template-columns: 1fr;
+  }
+
+  .scene-hotspot-buttons {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .condition-summary-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .report-heading,
+  .report-panel {
+    align-items: stretch;
+    flex-direction: column;
+  }
+}
