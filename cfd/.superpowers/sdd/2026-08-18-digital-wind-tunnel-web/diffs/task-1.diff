@@ -0,0 +1,127 @@
+:root {
+  --bg: #071014;
+  --panel: #0d181d;
+  --panel-raised: #132229;
+  --tunnel: #e9e6df;
+  --ink: #e9f2f3;
+  --muted: #8da3aa;
+  --flow: #50e3c2;
+  --warning: #f2bd4f;
+  --danger: #e44b43;
+  color: var(--ink);
+  background: var(--bg);
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  min-width: 320px;
+  min-height: 100vh;
+  background: var(--bg);
+}
+
+button,
+input,
+select,
+textarea {
+  font: inherit;
+}
+
+.app-shell {
+  display: grid;
+  grid-template-areas:
+    "header header header"
+    "left scene right"
+    "left bottom right";
+  grid-template-columns: 240px minmax(0, 1fr) 320px;
+  grid-template-rows: auto minmax(0, 1fr) 220px;
+  min-height: 100vh;
+  background: var(--bg);
+}
+
+.topbar {
+  grid-area: header;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 0.85rem 1.25rem;
+  border-bottom: 1px solid var(--panel-raised);
+  background: var(--panel);
+}
+
+.eyebrow {
+  color: var(--flow);
+  font-size: 0.7rem;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+}
+
+h1 {
+  margin: 0.15rem 0 0;
+  font-size: 1.15rem;
+}
+
+.topbar-actions {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+}
+
+.provenance-badge {
+  color: var(--warning);
+  font-size: 0.72rem;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+}
+
+.tutorial-rail,
+.control-panel,
+.chart-drawer {
+  padding: 1rem;
+  background: var(--panel);
+}
+
+.tutorial-rail {
+  grid-area: left;
+  border-right: 1px solid var(--panel-raised);
+}
+
+.scene-panel {
+  grid-area: scene;
+  padding: 1rem;
+  background: var(--panel-raised);
+}
+
+.control-panel {
+  grid-area: right;
+  border-left: 1px solid var(--panel-raised);
+}
+
+.chart-drawer {
+  grid-area: bottom;
+  border-top: 1px solid var(--panel-raised);
+}
+
+@media (max-width: 900px) {
+  .app-shell {
+    grid-template-areas:
+      "header"
+      "scene"
+      "left"
+      "right"
+      "bottom";
+    grid-template-columns: minmax(0, 1fr);
+    grid-template-rows: auto minmax(18rem, 1fr) auto auto 220px;
+  }
+
+  .tutorial-rail,
+  .control-panel {
+    border: 0;
+    border-top: 1px solid var(--panel-raised);
+  }
+}
