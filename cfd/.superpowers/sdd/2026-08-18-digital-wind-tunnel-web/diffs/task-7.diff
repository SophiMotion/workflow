+type VelocityField = {
+  width: number;
+  height: number;
+  velocityX: Float32Array;
+  velocityY: Float32Array;
+};
+
+export type FlowVelocity = { x: number; y: number };
+
+function clamp01(value: number) {
+  return Math.min(1, Math.max(0, Number.isFinite(value) ? value : 0));
+}
+
+function bilinear(values: Float32Array, width: number, height: number, u: number, v: number) {
+  if (width <= 0 || height <= 0 || values.length === 0) return 0;
+
+  const x = clamp01(u) * Math.max(0, width - 1);
+  const y = clamp01(v) * Math.max(0, height - 1);
+  const x0 = Math.floor(x);
+  const y0 = Math.floor(y);
+  const x1 = Math.min(width - 1, x0 + 1);
+  const y1 = Math.min(height - 1, y0 + 1);
+  const tx = x - x0;
+  const ty = y - y0;
+  const at = (column: number, row: number) => values[row * width + column] ?? 0;
+  const top = at(x0, y0) * (1 - tx) + at(x1, y0) * tx;
+  const bottom = at(x0, y1) * (1 - tx) + at(x1, y1) * tx;
+  return top * (1 - ty) + bottom * ty;
+}
+
+export function sampleFlowVelocity(frame: VelocityField, u: number, v: number): FlowVelocity {
+  return {
+    x: bilinear(frame.velocityX, frame.width, frame.height, u, v),
+    y: bilinear(frame.velocityY, frame.width, frame.height, u, v),
+  };
+}
