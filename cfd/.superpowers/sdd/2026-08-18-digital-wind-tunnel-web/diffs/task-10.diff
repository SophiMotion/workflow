+++ b/src/features/shell/AppShell.tsx
@@ -0,0 +1,92 @@
+import { useRef, useState, type KeyboardEvent as ReactKeyboardEvent, type ReactNode } from "react";
+
+export type AppShellProps = {
+  left: ReactNode;
+  scene: ReactNode;
+  right: ReactNode;
+  bottom: ReactNode;
+  headerActions?: ReactNode;
+};
+
+type CompactPanel = "tutorial" | "controls" | "charts";
+
+const COMPACT_PANELS: readonly { id: CompactPanel; label: string }[] = [
+  { id: "tutorial", label: "教程" },
+  { id: "controls", label: "控制" },
+  { id: "charts", label: "曲线" },
+];
+
+export function AppShell({ left, scene, right, bottom, headerActions }: AppShellProps) {
+  const [compactPanel, setCompactPanel] = useState<CompactPanel>("tutorial");
+  const tabRefs = useRef<Array<HTMLButtonElement | null>>([]);
+  const selectAdjacentTab = (event: ReactKeyboardEvent<HTMLButtonElement>, index: number) => {
+    let nextIndex: number | undefined;
+    if (event.key === "ArrowRight" || event.key === "ArrowDown") {
+      nextIndex = (index + 1) % COMPACT_PANELS.length;
+    } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
+      nextIndex = (index - 1 + COMPACT_PANELS.length) % COMPACT_PANELS.length;
+    } else if (event.key === "Home") {
+      nextIndex = 0;
+    } else if (event.key === "End") {
+      nextIndex = COMPACT_PANELS.length - 1;
+    }
+    if (nextIndex === undefined) return;
+    event.preventDefault();
+    const nextPanel = COMPACT_PANELS[nextIndex]!;
+    setCompactPanel(nextPanel.id);
+    tabRefs.current[nextIndex]?.focus();
+  };
+
+  return (
+    <div className="app-shell">
+      <header className="topbar" role="banner">
+        <div>
+          <span className="eyebrow">CFD TEACHING CONSOLE</span>
+          <h1>SophiFlow Lab</h1>
+        </div>
+        <div className="topbar-actions">
+          {headerActions}
+          <span className="model-scope-badge">2D TEACHING CFD / 二维教学近似</span>
+          <span className="provenance-badge">SIMULATED / 模拟数据</span>
+        </div>
+      </header>
+      <div className="compact-panel-tabs" role="tablist" aria-label="窄屏实验面板">
+        {COMPACT_PANELS.map((panel, index) => (
+          <button
+            type="button"
+            role="tab"
+            aria-controls={`compact-panel-${panel.id}`}
+            aria-selected={compactPanel === panel.id}
+            id={`compact-tab-${panel.id}`}
+            key={panel.id}
+            ref={(element) => { tabRefs.current[index] = element; }}
+            tabIndex={compactPanel === panel.id ? 0 : -1}
+            onClick={() => setCompactPanel(panel.id)}
+            onKeyDown={(event) => selectAdjacentTab(event, index)}
+          >
+            {panel.label}
+          </button>
+        ))}
+      </div>
+      <nav
+        className="tutorial-rail"
+        aria-label="教学章节"
+        data-compact-active={compactPanel === "tutorial"}
+        id="compact-panel-tutorial"
+      >{left}</nav>
+      <main className="scene-panel" aria-label="数字风洞">{scene}</main>
+      <aside
+        className="control-panel"
+        aria-label="实验控制"
+        data-compact-active={compactPanel === "controls"}
+        id="compact-panel-controls"
+      >{right}</aside>
+      <section
+        className="chart-drawer"
+        aria-label="实验曲线"
+        data-compact-active={compactPanel === "charts"}
+        id="compact-panel-charts"
+      >{bottom}</section>
+    </div>
+  );
+}
diff --git a/src/features/flow/flowRuntime.ts b/src/features/flow/flowRuntime.ts
new file mode 100644
index 0000000..edfd096
--- /dev/null
+++ b/src/features/flow/flowRuntime.ts
@@ -0,0 +1,145 @@
+import { labStore } from "../experiment/labStore";
+import { FlowWorkerError } from "./LbmWorkerClient";
+import type { FlowFieldFrame } from "./types";
+
+const FRAME_INTERVAL_MS = 100;
+
+export interface FlowClientLike {
+  requestFrame(inletVelocity: number, iterations?: number): Promise<FlowFieldFrame>;
+  restart(): Promise<void>;
+}
+
+export interface FlowRuntime {
+  stop(): void;
+  restart(): Promise<void>;
+}
+
+export function mapWindToLatticeVelocity(windSpeedMps: number): number {
+  return Math.min(0.08, Math.max(0, windSpeedMps / 12 * 0.08));
+}
+
+export function startFlowRuntime(client: FlowClientLike): FlowRuntime {
+  let stopped = false;
+  let pending = false;
+  let restarting = false;
+  let failed = false;
+  let recoveryUsed = false;
+  let velocityScale = 1;
+  let generation = 0;
+  let restartPromise: Promise<void> | null = null;
+
+  labStore.setState({ flowStatus: "loading", flowError: null });
+
+  const tick = async () => {
+    if (stopped || failed || pending || restarting || document.hidden) {
+      return;
+    }
+
+    pending = true;
+    const tickGeneration = generation;
+    const windSpeedMps = labStore.getState().telemetry.windSpeedMps;
+    const inletVelocity = mapWindToLatticeVelocity(windSpeedMps) * velocityScale;
+
+    try {
+      let nextFrame: FlowFieldFrame;
+      try {
+        nextFrame = await client.requestFrame(inletVelocity);
+      } catch (error) {
+        if (!isNumericalInstability(error) || recoveryUsed) {
+          throw error;
+        }
+
+        recoveryUsed = true;
+        velocityScale *= 0.8;
+        labStore.setState((state) => ({
+          eventLog: [
+            ...state.eventLog,
+            "二维教学 CFD 数值场异常：入口格点速度已降至 80%，正在重启求解器。",
+          ],
+        }));
+        await client.restart();
+        nextFrame = await client.requestFrame(inletVelocity * 0.8);
+      }
+
+      if (!stopped && tickGeneration === generation) {
+        labStore.setState({
+          flowField: nextFrame,
+          flowStatus: "ready",
+          flowError: null,
+        });
+      }
+    } catch (error) {
+      if (!stopped && tickGeneration === generation) {
+        failed = true;
+        labStore.setState({
+          flowStatus: "failed",
+          flowError: errorMessage(error),
+        });
+      }
+    } finally {
+      if (tickGeneration === generation) {
+        pending = false;
+      }
+    }
+  };
+
+  const timer = setInterval(() => {
+    void tick();
+  }, FRAME_INTERVAL_MS);
+
+  return {
+    stop() {
+      if (stopped) {
+        return;
+      }
+      stopped = true;
+      generation += 1;
+      clearInterval(timer);
+    },
+    restart() {
+      if (stopped) {
+        return Promise.reject(new Error("Flow runtime is stopped"));
+      }
+      if (restartPromise !== null) return restartPromise;
+
+      restarting = true;
+      const restartGeneration = generation + 1;
+      generation = restartGeneration;
+      failed = false;
+      recoveryUsed = false;
+      velocityScale = 1;
+      labStore.setState({ flowError: null });
+      restartPromise = (async () => {
+        try {
+          await client.restart();
+        } catch (error) {
+          if (!stopped && restartGeneration === generation) {
+            failed = true;
+            labStore.setState({
+              flowStatus: "failed",
+              flowError: errorMessage(error),
+            });
+          }
+          throw error;
+        } finally {
+          if (restartGeneration === generation) {
+            pending = false;
+            restarting = false;
+          }
+          restartPromise = null;
+        }
+      })();
+      return restartPromise;
+    },
+  };
+}
+
+function isNumericalInstability(error: unknown): boolean {
+  return error instanceof FlowWorkerError && error.code === "NON_FINITE_FIELD"
+    || (typeof error === "object" && error !== null && "code" in error
+      && error.code === "NON_FINITE_FIELD");
+}
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : "Unknown flow worker failure";
+}
