+  await user.click(screen.getByRole("button", { name: "自由实验" }));
+  await user.click(screen.getByRole("button", { name: "进入下一章" }));
+  expect(screen.getByRole("heading", { name: "第 2 章：启动虚拟风扇" })).toBeInTheDocument();
+
