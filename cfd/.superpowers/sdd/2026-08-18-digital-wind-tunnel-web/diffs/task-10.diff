+  }
+
+  .compact-panel-tabs {
+    grid-area: tabs;
+    z-index: 6;
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    min-width: 0;
+    border-top: 1px solid #294049;
+    border-bottom: 1px solid #294049;
+    background: var(--panel);
+  }
+
+  .compact-panel-tabs button {
+    min-width: 44px;
+    min-height: 44px;
+    border: 0;
+    border-right: 1px solid #294049;
+    color: var(--muted);
+    background: var(--panel);
+    cursor: pointer;
+  }
+
+  .compact-panel-tabs button[aria-selected="true"] {
+    color: var(--flow);
+    box-shadow: inset 0 -3px 0 var(--flow);
+  }
+
+  .tutorial-rail,
+  .control-panel,
+  .chart-drawer {
+    display: none;
+    grid-area: compact-panel;
+    border: 0;
+    min-width: 0;
+    max-width: 100vw;
+    overflow: auto;
+  }
+
+  .tutorial-rail[data-compact-active="true"],
+  .control-panel[data-compact-active="true"],
+  .chart-drawer[data-compact-active="true"] {
+    display: block;
+  }
+
+  .scene-hotspots {
+    grid-template-columns: 1fr;
+  }
+
+  .scene-hotspot-buttons {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .condition-summary-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .report-heading,
+  .report-panel {
+    align-items: stretch;
+    flex-direction: column;
+  }
+}
+
+@media (max-width: 600px) {
+  .app-shell {
+    grid-template-rows: 52px 48vh 48px minmax(0, auto);
