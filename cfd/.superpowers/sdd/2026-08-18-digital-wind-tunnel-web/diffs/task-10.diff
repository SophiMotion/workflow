+@media print {
+  .topbar,
+  .compact-panel-tabs,
+  .tutorial-rail,
+  .scene-panel,
+  .control-panel,
+  .history-panel,
+  .sweep-actions,
+  .report-actions {
+    display: none !important;
+  }
+
+  .app-shell,
+  .chart-drawer {
+    display: block;
+    color: #111;
+    background: #fff;
+  }
+
+  .experiment-report,
+  .condition-card,
+  .comparison-panel,
+  .report-panel {
+    border-color: #aaa;
+    color: #111;
+    background: #fff;
+  }
+}
